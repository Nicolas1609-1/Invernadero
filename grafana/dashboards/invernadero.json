{
  "uid": "invernadero",
  "title": "Invernadero - 10 dispositivos",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "2026-10-26T00:00:00Z",
    "to": "2026-10-31T00:00:00Z"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperatura",
      "datasource": {
        "type": "postgres",
        "uid": "greenhouse-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(ts::timestamptz, $__interval), avg(value) AS value, device AS metric FROM readings WHERE $__timeFilter(ts::timestamptz) AND variable='temperature' GROUP BY 1,3 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 32
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "mean",
            "min",
            "max"
          ]
        }
      }
    },
